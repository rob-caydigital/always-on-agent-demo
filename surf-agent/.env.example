# Copy to .env and fill in. .env is gitignored.

# Anthropic: optional if you are logged in with `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=

# NWS asks every API client to identify itself with a contact address.
NWS_CONTACT_EMAIL=you@example.com

# Voice Monkey v3 (https://console.voicemonkey.io). Leave the token blank to run in
# SIMULATED mode: the agent logs the exact calls it would make instead of sending them.
VOICEMONKEY_TOKEN=
VOICEMONKEY_TRIGGER_DEVICE=surf-wake      # Routine Trigger device ID
VOICEMONKEY_SPEAKER_DEVICE=bedroom        # Speaker device ID (for the spoken summary)
